    {
      "parameters": {
        "jsCode": "// Appels utilisables pour les récurrences : [date, heure, zone de départ, véhicule, type de service, statut]\nconst rows = [];\nfor (const it of $input.all()) {\n  const r = it.json;\n  const date = String(r.trip_date ?? '').trim();\n  const time = String(r.trip_time ?? '').trim();\n  const zone = String(r.departure_zone ?? '').trim();\n  const status = String(r.current_status ?? '').trim();\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(date) || !/^\\d{2}:\\d{2}:\\d{2}$/.test(time)) continue;\n  if (!/^\\d+$/.test(zone)) continue;\n  if (status === 'historique_xlsx') {\n    if (String(r.source_treatment ?? '').trim() === 'Exclu') continue;\n  } else if (!status.startsWith('recu') && !status.startsWith('pris')) continue;\n  rows.push([date, time, zone, String(r.vehicle_id ?? '').trim(), String(r.service_type ?? '').trim(), status]);\n}\nreturn [{ json: { ok: true, count: rows.length, rows } }];"
      },
